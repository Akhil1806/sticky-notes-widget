<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"> <!-- Space for shadow/margins -->

    <!-- Background Image (tinted programmatically) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_shape"
        android:scaleType="fitXY"
        android:elevation="4dp" />

    <!-- Content -->
    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="5dp">

        <!-- Title row -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Sticky Note"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingBottom="8dp" />

        <!-- Content -->
        <TextView
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Tap to add content..."
            android:textSize="14sp"
            android:textColor="#3E2723"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="8"
            android:ellipsize="end"
            android:gravity="top" />

        <!-- Category tag -->
        <TextView
            android:id="@+id/widget_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:alpha="0.6"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:textAllCaps="true" />

    </LinearLayout>
</FrameLayout>
